# ══════════════════════════════════════════════════════════════
# 复制为 .env 后填入真实值。.env 已被 gitignore。
# ══════════════════════════════════════════════════════════════

# ── 数据库（docker compose up -d postgres）──────────────────────
POSTGRES_USER=dressing
POSTGRES_PASSWORD=dressing
POSTGRES_DB=dressing
POSTGRES_PORT=5432
DATABASE_URL=postgres://dressing:dressing@localhost:5432/dressing

# ── 图像生成：fal.ai ───────────────────────────────────────────
# https://fal.ai/dashboard/keys   （需双币信用卡，美元预付费积分）
FAL_KEY=

# 需要 tool calling + 视觉能力。**当前只有 ANTHROPIC_API_KEY 会被读取** ——
# 入口页的环境判定与取模型都只看它，填别的不会生效。
ANTHROPIC_API_KEY=
# 预留：带 Vision 且支持 Tool Calls 的廉价档。
# ⚠️ 尚未接线：只填这一个的话，入口页会一直显示"对话功能还没配置好"，且不会告诉你原因。
DEEPSEEK_API_KEY=

# 指向 Anthropic **兼容**网关。留空则走官方 api.anthropic.com。
# 自建代理、聚合服务、本地推理都可以填这里。
# ANTHROPIC_BASE_URL=https://opencode.ai/zen/go/v1
#
# 模型名。**用非官方端点时几乎一定要设**：网关通常在同一个端点上挂多家模型，
# 而默认值（deepseek-v4-flash-vision-exp）是实测跑通过的那个，
# 官方端点不认识它。
# ANTHROPIC_MODEL=deepseek-v4-flash-vision-exp
#
# 额外请求头，JSON 格式。有些网关不带头就直接 400。
# ANTHROPIC_EXTRA_HEADERS={"x-opencode-session":"dressing-app"}

# 只有 local 可用。**r2 驱动尚未实现**：设成 r2 会直接抛错（刻意如此，见 README 架构一节）。
# 开发用 local；上线切 r2（出网免费）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data
STORAGE_LOCAL_BASE_URL=/api/files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── 队列与配额 ─────────────────────────────────────────────────
# fal 新账号默认 2 并发，随 credits 提升可自助调到 40。
# 这里必须与实际额度对齐，否则会互相排队拖慢。
FAL_CONCURRENCY=2
# 每 session 每日生成次数上限（防误触烧钱）
DAILY_GENERATION_LIMIT=30

# ── 合规 ───────────────────────────────────────────────────────
# 输出图是否叠加"AI 生成"显式水印（《AI 生成合成内容标识办法》要求）
AI_WATERMARK_ENABLED=true

# ── 应用 ───────────────────────────────────────────────────────
# 端口用 4000 而非默认的 3000：Windows 上 Docker/WSL2 会保留 2941-3040 端口段
# （可用 `netsh interface ipv4 show excludedportrange protocol=tcp` 查看），
# 默认的 3000 落在其中会导致绑定失败（EACCES）。
APP_URL=http://localhost:4000
