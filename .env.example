# ══════════════════════════════════════════════════════════════
# 复制为 .env 后填入真实值。.env 已被 gitignore。
# ══════════════════════════════════════════════════════════════

# ── 数据库（docker compose up -d postgres）──────────────────────
POSTGRES_USER=dressing
POSTGRES_PASSWORD=dressing
POSTGRES_DB=dressing
POSTGRES_PORT=5432
DATABASE_URL=postgres://dressing:dressing@localhost:5432/dressing

# ── 图像生成：fal.ai ───────────────────────────────────────────
# https://fal.ai/dashboard/keys   （需双币信用卡，美元预付费积分）
FAL_KEY=

# ── Agent 与视觉识别（LLM）──────────────────────────────────────
# 需要 tool calling + 视觉能力。二选一或都填，代码按优先级取用。
ANTHROPIC_API_KEY=
# 备用：带 Vision 且支持 Tool Calls 的廉价档
DEEPSEEK_API_KEY=

# ── 商品链接解析 ────────────────────────────────────────────────
# Tier A：万邦开放平台（淘宝/天猫/京东）—— 需注册询价
# https://open.onebound.cn
ONEBOUND_KEY=
ONEBOUND_SECRET=
# Tier B：Firecrawl（国际品牌站 / Shopify / Amazon）
FIRECRAWL_API_KEY=

# ── 存储 ───────────────────────────────────────────────────────
# 开发用 local；上线切 r2（出网免费）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data
STORAGE_LOCAL_BASE_URL=/api/files
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── 队列与配额 ─────────────────────────────────────────────────
# fal 新账号默认 2 并发，随 credits 提升可自助调到 40。
# 这里必须与实际额度对齐，否则会互相排队拖慢。
FAL_CONCURRENCY=2
# 每 session 每日生成次数上限（防误触烧钱）
DAILY_GENERATION_LIMIT=30

# ── 合规 ───────────────────────────────────────────────────────
# 输出图是否叠加"AI 生成"显式水印（《AI 生成合成内容标识办法》要求）
AI_WATERMARK_ENABLED=true

# ── 应用 ───────────────────────────────────────────────────────
# 端口用 4000 而非默认的 3000：Windows 上 Docker/WSL2 会保留 2941-3040 端口段
# （可用 `netsh interface ipv4 show excludedportrange protocol=tcp` 查看），
# 默认的 3000 落在其中会导致绑定失败（EACCES）。
APP_URL=http://localhost:4000
